--// ROOT
local function GetRoot()
    local Character = Player.Character
    if not Character then return nil end
    return Character:FindFirstChild("HumanoidRootPart")
end

--// SPEED
local function ApplySpeed()
    if not Enabled then return end
    local Root = GetRoot()
    if not Root then return end
    local Character = Root.Parent
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        pcall(function()
            Humanoid.WalkSpeed = SPEED
        end)
    end
    pcall(function()
        local Look = Root.CFrame.LookVector
        Root.AssemblyLinearVelocity = Vector3.new(
            Look.X * SPEED,
            Root.AssemblyLinearVelocity.Y,
            Look.Z * SPEED
        )
    end)
end

--// BUSCAR CARRERA
local function FindRacePart()
    local Root = GetRoot()
    if not Root then return nil end
    local Best = nil
    local BestDistance = math.huge
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("BasePart") then
            local Name = Object.Name:lower()
            if Name:find("race") or Name:find("start") or Name:find("begin") or Name:find("join") then
                local Distance = (Object.Position - Root.Position).Magnitude
                if Distance < BestDistance then
                    BestDistance = Distance
                    Best = Object
                end
            end
        end
    end
    return Best
end

--// ENTRAR EN LA CARRERA
local function JoinRace()
    if not Enabled then return end
    local Root = GetRoot()
    if not Root then return end
    local RacePart = FindRacePart()
    if RacePart then
        pcall(function()
            Root.CFrame = RacePart.CFrame + Vector3.new(0, 4, 0)
        end)
    end
end

--// PARAR VELOCIDAD
local function StopSpeed()
    local Root = GetRoot()
    if not Root then return end
    local Humanoid = Root.Parent:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        pcall(function()
            Humanoid.WalkSpeed = NormalSpeed
        end)
    end
    pcall(function()
        Root.AssemblyLinearVelocity = Vector3.zero
    end)
end

--// BUSCAR PUNTO SEGURO
local function FindSafePlace()
    local Root = GetRoot()
    if not Root then return nil end
    local Best = nil
    local BestDistance = math.huge
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("BasePart") then
            local Name = Object.Name:lower()
            if Name:find("safe") or Name:find("spawn") or Name:find("lobby") or Name:find("finish") or Name:find("home") then
                local Distance = (Object.Position - Root.Position).Magnitude
                if Distance < BestDistance then
                    BestDistance = Distance
                    Best = Object
                end
            end
        end
    end
    return Best
end

--// IR AL PUNTO SEGURO AL APAGAR
local function GoSafe()
    task.wait(0.2)
    local Root = GetRoot()
    if not Root then return end
    local Safe = FindSafePlace()
    if Safe then
        pcall(function()
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.CFrame = Safe.CFrame + Vector3.new(0, 4, 0)
        end)
    end
end

--// ON / OFF
Toggle.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    if Enabled then
        Toggle.Text = "AUTO FARM: ON"
        Toggle.BackgroundColor3 = Color3.fromRGB(0, 150, 75)
        ToggleStroke.Color = Color3.fromRGB(0, 150, 75)
        local Humanoid = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            NormalSpeed = Humanoid.WalkSpeed
        end
        ApplySpeed()
        JoinRace()
    else
        Toggle.Text = "AUTO FARM: OFF"
        Toggle.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        ToggleStroke.Color = Color3.fromRGB(0, 200, 255)
        StopSpeed()
        GoSafe()
    end
end)

