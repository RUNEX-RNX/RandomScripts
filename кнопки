-- ========== ФУНКЦИЯ СОЗДАНИЯ КНОПКИ ==========
local function createBtn(text, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 30, 40)
    btn.AutoButtonColor = false
    btn.Parent = container

    local cornerBtn = Instance.new("UICorner")
    cornerBtn.CornerRadius = UDim.new(0, 6)
    cornerBtn.Parent = btn

    local strokeBtn = Instance.new("UIStroke")
    strokeBtn.Color = Color3.fromRGB(0, 200, 255)
    strokeBtn.Thickness = 1
    strokeBtn.Transparency = 0.5
    strokeBtn.Parent = btn

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        strokeBtn.Transparency = 0.2
    end)
    btn.MouseLeave:Connect(function()
        if btn.BackgroundColor3 ~= Color3.fromRGB(0, 150, 75) then
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            strokeBtn.Transparency = 0.5
        end
    end)

    return btn, strokeBtn
end

-- ========== ЭМУЛЯЦИЯ КЛАВИШ ==========
local function pressKey(key, duration)
    duration = duration or 0.1
    pcall(function()
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(duration)
        VirtualInput:SendKeyEvent(false, key, false, game)
    end)
end

local function holdKey(key)
    pcall(function()
        VirtualInput:SendKeyEvent(true, key, false, game)
    end)
end

local function releaseKey(key)
    pcall(function()
        VirtualInput:SendKeyEvent(false, key, false, game)
    end)
end

